# Copy to .env and fill in. .env is gitignored — never commit it.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > service_role (secret).
# Server-side only. Bypasses RLS. Must never reach the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name (created automatically on boot if missing)
SUPABASE_BUCKET=audio

# Sarvam dashboard > API Keys
SARVAM_API_KEY=

PORT=8787
